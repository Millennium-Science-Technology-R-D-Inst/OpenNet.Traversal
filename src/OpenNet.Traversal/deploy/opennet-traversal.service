[Unit]
Description=OpenNet NAT traversal probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opennet
Group=opennet
EnvironmentFile=-/etc/opennet/traversal.env
ExecStart=/usr/local/bin/OpenNet.Traversal --bind 0.0.0.0 --advertise 203.0.113.10 --directory-url https://server.example/api/v1/traversal/servers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
