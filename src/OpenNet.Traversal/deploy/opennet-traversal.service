[Unit]
Description=OpenNet NAT traversal probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opennet
Group=opennet
EnvironmentFile=/etc/opennet/traversal.env

ExecStart=/usr/local/bin/OpenNet.Traversal \
    --bind 0.0.0.0 \
    --advertise 103.236.69.23 \
    --stun-port 3478 \
    --http-port 48100 \
    --probe-timeout-ms 2500 \
    --max-probes-per-minute 60 \
    --node-name server-962918187339 \
    --heartbeat-seconds 60

Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
